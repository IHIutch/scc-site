    {
      "id": 6,
      "attributes": {
        "title": "Preferred Scenario for Reimagining the Scajaquada Corridor",
        "slug": "preferred-scenario-for-reimagining-the-scajaquada-corridor",
        "startingAt": "2023-01-17T23:00:00.000Z",
        "endingAt": null,
        "content": "Learn about the preferred scenario for Region Central. It has been developed over 18 months of research, planning, community outreach, analysis & it represents a range of possibilities for the future of mobility in the Scajaquada Corridor.\n\nRegister to Attend In Person: [Attend In Person](https://www.eventbrite.com/e/region-centralscajaquada-corridor-public-meeting-tickets-487980822777)\n\nRegister to Attend Virtually, via Zoom: [Attend Virtually](https://us02web.zoom.us/webinar/register/WN_EioLN6rBSZO_dqvE-G_LuA). You may also use this link to attend day-of.\n\nCanisius College is accessible by Metrorail at the **Delavan-College** stop.\n\nAll are welcome, but in-person attendance is limited to 150 people due to space constraints.",
        "createdAt": "2023-01-12T18:44:55.135Z",
        "updatedAt": "2023-01-12T19:13:53.767Z",
        "publishedAt": "2023-01-12T18:45:01.654Z",
